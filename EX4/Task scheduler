#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int leastInterval(char* tasks, int tasksSize, int n) {
    int freq[26] = {0};
    for (int i = 0; i < tasksSize; i++) {
        freq[tasks[i] - 'A']++;
    }

    int max_freq = 0;
    for (int i = 0; i < 26; i++) {
        if (freq[i] > max_freq) {
            max_freq = freq[i];
        }
    }

    int max_freq_tasks = 0;
    for (int i = 0; i < 26; i++) {
        if (freq[i] == max_freq) {
            max_freq_tasks++;
        }
    }

    int part_count = max_freq - 1;
    int part_length = n + 1;
    int empty_slots = part_count * part_length + max_freq_tasks;

    return tasksSize > empty_slots ? tasksSize : empty_slots;
}
